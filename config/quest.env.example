# Copy to config/quest.env for local controller-source settings.

QUEST_INPUT_MODE=controller
QUEST_CONTROLLER_RATE_HZ=60
QUEST_TRIGGER_THRESHOLD=0.5

# Legacy-only ADB network settings. The normal OpenXR route uses USB forwarding.
QUEST_IP_ADDRESS=
QUEST_ADB_IP=
QUEST_ADB_PORT=5555
# QUEST_ADB_BIN=/absolute/path/to/platform-tools/adb

# Strict OpenXR controller provider.
QUEST_CONTROLLER_BACKEND=openxr-tcp
QUEST_OPENXR_HOST=127.0.0.1
QUEST_OPENXR_PORT=9200
QUEST_SOURCE_STALE_TIMEOUT_S=0.3
